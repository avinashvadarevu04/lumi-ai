# ---------------------------------------------------------------------------
# Lupus AI Labs — backend configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5001

# Database. SQLite by default; for PostgreSQL set
#   DATABASE_URL="postgresql://user:pass@host:5432/lupus"
# and change `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./prisma/dev.db"

# Secrets — REQUIRED in production, minimum 32 characters.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
IP_HASH_SALT=

# Sessions
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=lupus_ops_session

# Hidden admin base path. Change this to something only your team knows.
ADMIN_BASE_PATH=/ops-gateway

# Front end origins allowed to call this API with credentials (comma separated).
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Express `trust proxy`. Use "loopback" when running directly, or the number of
# proxy hops (e.g. 1) when behind nginx / a load balancer. Setting this too
# broadly lets clients spoof their IP and bypass rate limiting.
TRUST_PROXY=loopback

# Serve frontend/dist from this server so the site and API share one origin.
SERVE_FRONTEND=false

# Initial administrator, consumed by `npm run db:seed`.
# Leave the password blank to have a strong one generated and printed once.
SEED_ADMIN_EMAIL=admin@lupusailabs.com
SEED_ADMIN_PASSWORD=
